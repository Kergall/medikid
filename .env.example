# Solana RPC endpoint (mainnet-beta, devnet, or custom)
RPC_ENDPOINT=https://api.mainnet-beta.solana.com

# Wallet private key in base58 format (KEEP SECRET)
PRIVATE_KEY=your_base58_private_key_here

# Trading configuration
INPUT_MINT=So11111111111111111111111111111111111111112       # SOL
OUTPUT_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v  # USDC

# Amount to swap (in lamports for SOL, or smallest unit for tokens)
# 1 SOL = 1000000000 lamports
AMOUNT=100000000

# Slippage tolerance in basis points (100 = 1%)
SLIPPAGE_BPS=50

# Bot strategy: "swap" | "dca" | "monitor"
STRATEGY=swap

# DCA settings (used when STRATEGY=dca)
DCA_INTERVAL_SECONDS=3600
DCA_REPETITIONS=24

# Price monitoring thresholds (used when STRATEGY=monitor)
PRICE_ALERT_ABOVE=1.05
PRICE_ALERT_BELOW=0.95

# Priority fee in microlamports (helps with transaction landing)
PRIORITY_FEE_MICROLAMPORTS=1000

# Retry settings
MAX_RETRIES=3
RETRY_DELAY_MS=2000
